# Triage Bugs Tool — environment configuration
# Copy to .env and fill in your real values: cp .env.example .env

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# === Security ===
# Fernet key used to encrypt integration credentials at rest in the database.
# Generate one with:
#   venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leaving this at the default is fine for local/single-user use (a random key
# is generated per process in that case), but every restart will then require
# re-testing integrations saved via the UI/API.
APP_ENCRYPTION_KEY=dev-encryption-key-change-in-production

# === Database (SQLite, no external service needed) ===
DATABASE_URL=sqlite:///./data/triage_bugs.db

# === Confluence ===
CONFLUENCE_BASE_URL=https://yourdomain.atlassian.net/wiki
CONFLUENCE_SPACE=YOURSPACE
CONFLUENCE_EMAIL=your.email@domain.com
CONFLUENCE_API_TOKEN=

# === Jira ===
JIRA_BASE_URL=https://yourdomain.atlassian.net
JIRA_EMAIL=your.email@domain.com
JIRA_API_TOKEN=

# === Gemini ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# === Storage ===
ARTIFACT_STORAGE_PATH=./data/artifacts
